{
  "name": "planty",
  "version": "1.0.1",
  "description": "Planty — home plant and pet care. In Russian the app is called Поливайка.",
  "author": "Yury Mikhno",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "build": {
    "appId": "com.duneholy.planty",
    "productName": "Planty",
    "asar": false,
    "files": [
      "desktop/main.js",
      "server.js",
      "catalogs.js",
      "lib/**/*",
      "public/**/*",
      "!public/_care*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "mac": {
      "category": "public.app-category.lifestyle",
      "icon": "public/icon-512.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ]
    },
    "dmg": {
      "title": "Установите Planty",
      "contents": [
        { "x": 160, "y": 170, "type": "file" },
        { "x": 430, "y": 170, "type": "link", "path": "/Applications" },
        { "x": 300, "y": 300, "type": "file", "path": "mac/Install Planty.command" }
      ]
    }
  }
}
